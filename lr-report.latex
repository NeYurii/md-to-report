$document-metadata.latex()$
$passoptions.latex()$

%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%% Style settings %%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Page style, reference in KOMA Script docs
\documentclass[
  usegeometry = true,
  fontsize = 14pt,
]{$documentclass$} % documentclass must stay in markdown, or some things will be broken

% No page numbers
\pagestyle{empty}

% Page margins (for main document part)
\usepackage[
  portrait,
  paper = a4paper,
  top = 20mm,
  bottom = 10mm,
  left = 25mm,
  right = 10mm,
]{geometry}

% Some needed packages loading
\usepackage{xcolor}
\usepackage{amsmath,amssymb}
\usepackage{fvextra}
\usepackage{ragged2e}
$fonts.latex()$
$font-settings.latex()$
$common.latex()$
$for(header-includes)$
$header-includes$
$endfor$

% Set figure placement
\usepackage{float}
\makeatletter
\def\fps@figure{H} % defult: htbp
\makeatother

% Default line spacing (1.5)
\usepackage[nodisplayskipstretch]{setspace}
\renewcommand{\onehalfspacing}{\setstretch{1.45}} % corresponds to office's 1.5
\renewcommand{\singlespacing}{\setstretch{0.9}} % corresponds to office's 1

% Headings setup
\RedeclareSectionCommand[
  font = \textbf\normalsize\rmfamily\Centering,
  style = section,
  afterindent = true,
  beforeskip = 33.6pt,
  afterskip = 33.6pt, % font size (14) * line height (2) * base line height (1.2)
]{chapter}
\RedeclareSectionCommand[
  font = \normalfont\normalsize\rmfamily\RaggedRight,
  indent = \parindent,
  afterindent = true,
  runin = false,
  beforeskip = \baselineskip,
  afterskip = 0pt,
]{section}
\RedeclareSectionCommand[
  font = \normalfont\normalsize\rmfamily\RaggedRight,
  indent = \parindent,
  afterindent = true,
  runin = false,
  beforeskip = 0pt,
  afterskip = 4.2pt,
]{subsection}

% Code snippets style
\DefineVerbatimEnvironment{Highlighting}{Verbatim}{
  fontsize = \footnotesize\singlespacing,
  commandchars = \\\{\},
}

% Table and figure caption format
\usepackage{caption}
\DeclareCaptionFormat{custom}{#1 #2 #3}
\DeclareCaptionLabelSeparator{dashsep}{-}
\captionsetup{
  format = custom,
  singlelinecheck = false,
  labelsep = dashsep,
  font = {normalsize,onehalfspacing},
}
\counterwithout{figure}{section}
\captionsetup[figure]{
  justification = Centering,
  position = below,
  name = Рисунок,
}
\counterwithout{table}{section}
\captionsetup[table]{
  justification = RaggedRight,
  hangindent = 2.64cm,
  position = above,
  name = Таблиця,
}

% List setup
\usepackage{enumitem}
\setlist{
  align=left, % align of label to labelindent
  leftmargin = 0pt,
  rightmargin = 0pt,
  listparindent = \parindent,
  labelindent = \parindent,
  labelwidth = *,
  itemindent = 0pt,
  topsep = 0pt,
  partopsep = 0pt,
  parsep = 0pt,
  itemsep = 0pt,
}
\setlist[itemize]{
  label = {-\AddToHookNext{para/after}{\addvspace{\itemsep}}}
}
\setlist[enumerate]{
  label = {\arabic*.\AddToHookNext{para/after}{\addvspace{\baselineskip}}}
}


% Tables setup
\AtBeginEnvironment{longtable}{\singlespacing\small\rmfamily}
\setlength{\LTpost}{0pt}
\setlength{\LTpre}{\baselineskip}

% section numbering
$if(numbersections)$
\setcounter{secnumdepth}{$if(secnumdepth)$$secnumdepth$$else$5$endif$}
$else$
\setcounter{secnumdepth}{-\maxdimen} % remove section numbering
$endif$


$after-header-includes.latex()$
$hypersetup.latex()$

$if(pdf-trailer-id)$
\ifXeTeX
\special{pdf:trailerid [ $pdf-trailer-id$ ]}
\fi
\ifPDFTeX
\pdftrailerid{}
\pdftrailer{/ID [ $pdf-trailer-id$ ]}
\fi
\ifLuaTeX
\pdfvariable trailerid {[ $pdf-trailer-id$ ]}
\fi
$endif$

\newcommand{\emptyline}{\vspace*{\baselineskip}}

\onehalfspacing

\begin{document}

%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%% Title page %%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%

\newgeometry{top = 20mm, bottom = 20mm, left = 25mm, right = 10mm}

\begin{Center}
    \textbf{Міністерство освіти і науки України}
    \emptyline

    Фаховий коледж зварювання та електроніки імені Є.О. Патона
    \emptyline\emptyline\emptyline\emptyline\emptyline

    \textbf{ЗВІТ}\emptyline

    \textbf{З ЛАБОРАТОРНОЇ РОБОТИ №$worknumber$}\emptyline

    навчальної дисципліни\\
    $subjectname$\\
    \underline{ФКЗЕ. $specialtycode$$subjectacronym$$listnumber$. $worknumber$ЛР}
    \emptyline\emptyline\emptyline\emptyline\emptyline
\end{Center}

\setlength{\RaggedRightLeftskip}{8.5cm}
\begin{FlushLeft} % Yes, FlushLeft uses RaggedRight
    Студент\hspace{19pt}\underline{$author$}\\
    Група\hspace{33pt}\underline{$group$}\\
    Перевірив\hspace{6pt}\underline{$lecturer$}\\
\end{FlushLeft}

\vfill

\begin{Center}
    $year$
\end{Center}

\restoregeometry

%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%% Document body %%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%

$for(include-before)$
$include-before$
$endfor$

\setlength{\RaggedRightLeftskip}{0pt}
\setlength{\RaggedRightParindent}{1cm}

\setlength{\JustifyingParindent}{1cm} % Paragraph offset
\justifying

$if(topic)$
\textbf{Тема:} $topic$
$endif$

$if(objective)$
\textbf{Мета:} $objective$
$endif$

$if(equipment)$
\textbf{Обладнання:} $equipment$
$endif$

$for(include-after)$
$include-after$
$endfor$

$body$

$if(conclusion)$
\emptyline
\textbf{Висновок:} $conclusion$
$endif$

\end{document}
