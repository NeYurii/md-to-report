\textbf{ЗВІТ}\emptyline

\textbf{З ЛАБОРАТОРНОЇ РОБОТИ №$worknumber$}\emptyline

навчальної дисципліни\\
$subjectname$\\
\underline{ФКЗЕ. $specialtycode$$subjectabbr$$listnumber$. $worknumber$ЛР}
\emptyline\emptyline\emptyline\emptyline\emptyline

\raggedright % left text align
\setlength{\parindent}{8.5cm} % Paragraph offset

Студент\hspace{19pt}\underline{$author$}\\
Група\hspace{33pt}\underline{$group$}\\
Перевірив\hspace{6pt}\underline{$lecturer$}\\

\vfill
\centering

$year$

\raggedright % left text align
\restoregeometry

%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%% Document body %%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%

\setlength{\parindent}{1cm} % Paragraph offset

\textbf{Тема:} $topic$\\
\textbf{Мета:} $objective$\\
$if(equipment)$
\textbf{Обладнання:} $equipment$
$endif$

$body$

