\section{Hello world in janet:}\label{hello-world-in-janet}

\begin{Shaded}
\begin{Highlighting}[]
\NormalTok{(defn main [\& args]}
\NormalTok{      (print "Hello world")}
\NormalTok{)}
\end{Highlighting}
\end{Shaded}

\subsection{Hello world in c:}\label{hello-world-in-c}

\begin{Shaded}
\begin{Highlighting}[]
\PreprocessorTok{\#include }\ImportTok{\textless{}stdio.h\textgreater{}}
\PreprocessorTok{\#include }\ImportTok{\textless{}errno.h\textgreater{}}
\PreprocessorTok{\#include }\ImportTok{\textless{}err.h\textgreater{}}

\DataTypeTok{int}\NormalTok{ main}\OperatorTok{(}\DataTypeTok{int}\NormalTok{ argc}\OperatorTok{,} \DataTypeTok{char} \OperatorTok{*}\NormalTok{argv}\OperatorTok{[])}
\OperatorTok{\{}
        \DataTypeTok{int}\NormalTok{ res }\OperatorTok{=}\NormalTok{ printf}\OperatorTok{(}\StringTok{"Hello world}\SpecialCharTok{\textbackslash{}n}\StringTok{"}\OperatorTok{);}
        \ControlFlowTok{if} \OperatorTok{(}\NormalTok{res }\OperatorTok{\textless{}} \DecValTok{0}\OperatorTok{)}\NormalTok{ err}\OperatorTok{(}\NormalTok{errno}\OperatorTok{,} \StringTok{"Failed to print hello world"}\OperatorTok{);}
        \ControlFlowTok{return} \DecValTok{0}\OperatorTok{;}
\OperatorTok{\}}
\end{Highlighting}
\end{Shaded}

