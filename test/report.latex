% Page style, reference in KOMA Script docs
\documentclass[
  usegeometry=true,
  fontsize=14pt,
]{scrreprt} % documentclass must stay in markdown, or some things will be broken

% No page numbers
\pagestyle{empty}

% Page margins (for main document part)
\usepackage[
  portrait,
  paper=a4paper,
  top=20mm,
  bottom=10mm,
  left=25mm,
  right=10mm
]{geometry}

% Some needed packages loading
\usepackage{xcolor}
